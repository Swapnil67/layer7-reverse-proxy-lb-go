# Compiled binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test artifacts and coverage reports
*.test
*.out
coverage.txt
profile.out

# Dependency and vendoring directories
# (Uncomment vendor/ if you do not want to check in vendored dependencies)
# vendor/

# Go workspace and build cache
go.work
go.work.sum

# Environment configurations and secrets
.env
.env.*
!.env.example

# IDE and Editor configurations
.idea/
.vscode/
*.swp
*~

# OS-specific files
.DS_Store
Thumbs.db

# Task runner (.task directory stores internal checksums and cache)
.task/

# Air (Live reload tool for Go)
# Ignore the temporary build output directory generated by Air (default is ./tmp)
tmp/

# If .air.toml contains local/machine-specific settings and shouldn't be committed:
# .air.toml